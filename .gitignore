# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# ----------------------------------
# Bundler
# ----------------------------------
/.bundle
/vendor/bundle/

# Ignore all environment files.
/.env*
/.envrc

# ----------------------------------
# Logs & temp files
# ----------------------------------
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# PID files
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# ----------------------------------
# Storage (ActiveStorage & tmp)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# ----------------------------------
# Rails master key
/config/*.key

# In case Rails credentials backup files appear
/config/credentials/*.yml.enc.old
/config/credentials/*.key.old

# ----------------------------------
# Byebug, Pry history
.byebug_history
.pry_history

# ----------------------------------
# SQLite database files (if using sqlite)
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.db

# ----------------------------------
# node / JavaScript tooling
/node_modules/
/yarn-error.log
/npm-debug.log

# ----------------------------------
# Assets
/public/assets
/public/packs
/public/packs-test
/public/packs/*

/public/uploads
/public/system
/public/.well-known

# ----------------------------------
# Ruby version manager files
/.ruby-version
/.ruby-gemset

# ----------------------------------
# Coverage (SimpleCov)
/coverage/

# ----------------------------------
# Editor-specific
# VSCode
.vscode/
/.idea/

# ----------------------------------
# OS-specific
.DS_Store
Thumbs.db
